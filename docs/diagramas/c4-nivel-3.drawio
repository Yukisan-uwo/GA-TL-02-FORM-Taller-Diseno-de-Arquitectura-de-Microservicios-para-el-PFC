        </mxCell>
        <mxCell id="n29" value="Deduplico por eventId y confirmo después de guardar inbox y cambio local. Ante fallos transitorios reintento a 10, 30 y 120 s.&#10;Conservo mensajes inválidos o agotados en la cola de errores del consumidor; aseguro la transferencia antes de reconocer el original." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=18;fillColor=#eaf2f8;strokeColor=#245a81;spacing=9;fillColor=none;strokeColor=none;fontSize=18;align=left;">
