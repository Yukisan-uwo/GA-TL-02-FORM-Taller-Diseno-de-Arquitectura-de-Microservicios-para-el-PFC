        <mxCell id="n46" value="Propongo un publicador de AccionAuditada en cada servicio para sus operaciones críticas, sin ciclos por el consumo de auditoría." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=18;fillColor=#eaf2f8;strokeColor=#245a81;spacing=9;fillColor=none;strokeColor=none;fontSize=17;align=left;">
          <mxGeometry x="980" y="805" width="770" height="65" as="geometry" />
        </mxCell>
        <mxCell id="n47" value="Desde RabbitMQ distribuyo: reservas → Refuerzos; avisos → Notificaciones; cambios → Seguimiento; AccionAuditada → Administración." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=18;fillColor=#eaf2f8;strokeColor=#245a81;spacing=9;fillColor=none;strokeColor=none;fontSize=18;align=left;fontStyle=1;">
          <mxGeometry x="30" y="1010" width="1720" height="45" as="geometry" />
        </mxCell>
        <mxCell id="n48" value="Conservo outbox y bandejas de entrada en la base propia. Mantengo colas de reintento y errores por consumidor.&#10;Presento un diseño propuesto, no servicios desplegados ni disponibilidad o rendimiento medidos." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=18;fillColor=#eaf2f8;strokeColor=#245a81;spacing=9;fillColor=none;strokeColor=none;fontSize=18;align=left;">
