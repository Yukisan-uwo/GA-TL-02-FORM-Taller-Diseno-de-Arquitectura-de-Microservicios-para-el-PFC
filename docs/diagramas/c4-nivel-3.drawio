        <mxCell id="n41" value="Enruto /api/ por REST/HTTPS; verifico permisos dentro de cada servicio." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=18;fillColor=#eaf2f8;strokeColor=#245a81;spacing=9;fillColor=none;strokeColor=none;fontSize=18;align=left;fontStyle=1;">
