        </mxCell>
        <mxCell id="n42" value="Valido matrícula por REST: Refuerzos → Académico. Solicito o consulto reservas por REST: Refuerzos → Espacios." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=18;fillColor=#eaf2f8;strokeColor=#245a81;spacing=9;fillColor=none;strokeColor=none;fontSize=18;align=left;fontStyle=1;">
