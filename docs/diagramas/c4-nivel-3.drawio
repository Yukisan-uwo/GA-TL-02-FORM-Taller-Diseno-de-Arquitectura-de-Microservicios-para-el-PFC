        <mxCell id="n28" value="Conservo los nombres del catálogo de eventos y distribuyo una copia por cola suscrita, no una copia compartida entre dominios." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=18;fillColor=#eaf2f8;strokeColor=#245a81;spacing=9;fillColor=none;strokeColor=none;fontSize=18;align=left;fontStyle=1;">
