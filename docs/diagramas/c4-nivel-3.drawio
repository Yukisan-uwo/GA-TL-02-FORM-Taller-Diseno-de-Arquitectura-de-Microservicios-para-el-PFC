        </mxCell>
        <mxCell id="n43" value="«Infraestructura de mensajería · RabbitMQ»&#10;Propongo sgra.eventos (topic durable) y colas de quórum sobre tres nodos&#10;Distribuyo copias independientes; no comparto una cola entre consumidores distintos" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=18;fillColor=#eaf2f8;strokeColor=#245a81;spacing=9;fillColor=#fff3df;strokeColor=#b86a17;fontSize=20;">
